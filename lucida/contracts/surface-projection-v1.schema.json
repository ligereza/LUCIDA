{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmaxia.local/lucida/surface-projection-v1.schema.json",
  "title": "LUCIDA Surface Projection v1",
  "type": "object",
  "required": [
    "contract_type",
    "schema_version",
    "host_id",
    "surface_id",
    "status",
    "proposal",
    "safety"
  ],
  "properties": {
    "contract_type": { "const": "SurfaceProjection" },
    "schema_version": { "const": "1.0" },
    "host_id": { "type": "string", "minLength": 1 },
    "surface_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["pending_approval", "approved", "rejected", "undone"]
    },
    "proposal": {
      "type": "object",
      "required": [
        "proposal_id",
        "reason",
        "evidence",
        "execution_mode",
        "requires_explicit_approval",
        "reversible"
      ],
      "properties": {
        "proposal_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "execution_mode": { "const": "proposal_only" },
        "requires_explicit_approval": { "const": true },
        "reversible": { "const": true }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "proposal_only",
        "automatic_actions",
        "external_side_effects",
        "host_opened"
      ],
      "properties": {
        "proposal_only": { "const": true },
        "automatic_actions": { "const": false },
        "external_side_effects": { "const": false },
        "host_opened": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
