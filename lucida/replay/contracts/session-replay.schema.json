{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lucida:replay:session-replay",
  "title": "Lucida Session Replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "entries"],
  "properties": {
    "fixture_type": { "const": "LucidaSessionReplayFixture" },
    "schema_version": { "const": "0.1" },
    "session_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "signal", "results"],
        "properties": {
          "event": { "type": "object" },
          "signal": { "type": "object" },
          "results": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
