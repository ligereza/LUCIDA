{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lucida:signals:application-event",
  "title": "ApplicationEvent",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "source_app",
    "event_type",
    "channel",
    "payload",
    "source_timestamp",
    "received_timestamp",
    "session_id",
    "peer_id",
    "sequence",
    "raw_hash",
    "provenance"
  ],
  "properties": {
    "contract_type": { "const": "ApplicationEvent" },
    "schema_version": { "const": "0.1" },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "source_app": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "event_type": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "channel": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "payload": { "type": "object" },
    "source_timestamp": { "type": "string", "format": "date-time" },
    "received_timestamp": { "type": "string", "format": "date-time" },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "peer_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "sequence": { "type": "integer", "exclusiveMinimum": 0 },
    "raw_hash": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "provenance": { "type": "object" }
  }
}
