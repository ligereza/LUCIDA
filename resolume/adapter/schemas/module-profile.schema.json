{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ligereza:lucida:resolume-adapter:module-profile.schema.json",
  "title": "RESOLUME_ADAPTER LED Module Profile",
  "description": "Physical LED fixture/cabinet information related to a processor snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_type", "profile_id", "environment", "fixtures", "provenance"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "profile_type": { "const": "ResolumeAdapterModuleProfile" },
    "profile_id": { "type": "string", "minLength": 1 },
    "venue": { "type": "string" },
    "environment": { "$ref": "#/$defs/fact" },
    "fixtures": { "type": "array", "items": { "$ref": "#/$defs/fixture" } },
    "processor_profile_id": { "type": ["string", "null"] },
    "receiving_system": { "type": "object" },
    "topology": { "type": "object" },
    "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "origin", "confidence"],
      "properties": {
        "value": {},
        "origin": { "enum": ["declared", "observed", "inferred", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "pixel_resolution", "physical_size_mm", "pixel_pitch_mm", "environment"],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "pixel_resolution": {
          "type": "object",
          "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        },
        "physical_size_mm": {
          "type": "object",
          "required": ["width", "height"],
          "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "pixel_pitch_mm": { "$ref": "#/$defs/fact" },
        "environment": { "$ref": "#/$defs/fact" },
        "brightness_nits": { "$ref": "#/$defs/fact" },
        "refresh_hz": { "$ref": "#/$defs/fact" },
        "receiving_card": { "type": "object" },
        "calibration": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": { "enum": ["manual", "label_photo", "technician", "observed", "measurement", "unknown"] },
        "detail": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    }
  }
}
