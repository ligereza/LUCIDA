{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ligereza:lucida:resolume-adapter:show-profile.schema.json",
  "title": "RESOLUME_ADAPTER ShowProfile",
  "description": "Perfil de destino de un show para comparar media de forma segura.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "name", "target"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "target": { "$ref": "#/$defs/target" },
    "source": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "codec": { "type": "string" },
        "allowed_codecs": { "type": "array", "items": { "type": "string" } },
        "requires_alpha": { "type": "boolean" },
        "color_range": { "type": "string" },
        "color_space": { "type": "string" },
        "refresh_hz": { "type": "number", "exclusiveMinimum": 0 },
        "notes": { "type": "string" }
      }
    }
  }
}
