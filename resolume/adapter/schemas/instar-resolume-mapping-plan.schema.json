{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ligereza:lucida:resolume-adapter:instar-resolume-mapping-plan.schema.json",
  "title": "RESOLUME_ADAPTER InstarResolumeMappingPlan",
  "description": "Plan de asignaciones sugeridas entre perfiles INSTAR y slices de Advanced Output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_type",
    "generated_at",
    "read_only",
    "status",
    "source_map",
    "catalog",
    "composition",
    "validation",
    "screens",
    "slices",
    "assignments",
    "slice_candidates",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "plan_type": { "const": "InstarResolumeMappingPlan" },
    "generated_at": { "type": "string", "format": "date-time" },
    "read_only": { "const": true },
    "status": { "enum": ["PASS", "WARN", "FAIL"] },
    "source_map": { "type": "object" },
    "catalog": { "type": "object" },
    "composition": { "type": "object" },
    "validation": { "type": "object" },
    "screens": { "type": "array" },
    "slices": { "type": "array" },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "slice_candidates": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_path",
        "asset_dimensions",
        "scaling",
        "slice_id",
        "slice_name",
        "screen_name",
        "input_group_id",
        "target_slice_ids",
        "score",
        "match_quality",
        "confidence",
        "requires_review",
        "eligible_for_auto_apply",
        "match",
        "alternatives",
        "operation"
      ],
      "properties": {
        "asset_id": { "type": "string" },
        "asset_path": { "type": "string" },
        "asset_dimensions": { "type": "object" },
        "scaling": { "type": "object" },
        "slice_id": { "type": "string" },
        "slice_name": { "type": "string" },
        "screen_name": { "type": "string" },
        "input_group_id": { "type": "string" },
        "target_slice_ids": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "match_quality": { "enum": ["GOOD", "POSSIBLE", "NO_GOOD_MATCH"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "requires_review": { "type": "boolean" },
        "eligible_for_auto_apply": { "type": "boolean" },
        "match": { "type": "object" },
        "alternatives": { "type": "array", "items": { "type": "object" } },
        "operation": { "const": "suggest_assignment_to_input_group" }
      },
      "additionalProperties": false
    }
  }
}
