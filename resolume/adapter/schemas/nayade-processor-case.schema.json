{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ligereza:lucida:resolume-adapter:nayade-processor-case.schema.json",
  "title": "RESOLUME_ADAPTER NayadeProcessorCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "case_type",
    "date_local",
    "stage",
    "system",
    "observations",
    "diagnostic_hypotheses",
    "expected_nayade_behavior",
    "event_sequence"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "case_type": { "const": "NayadeProcessorRegressionCase" },
    "date_local": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "stage": { "const": "NAYADE" },
    "system": { "type": "object", "additionalProperties": true },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    },
    "diagnostic_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "expected_nayade_behavior": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "event_sequence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": {},
        "before": {},
        "after": {},
        "unit": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "anyOf": [
        { "required": ["value"] },
        { "required": ["before"] },
        { "required": ["after"] }
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_time", "event", "scope"],
      "properties": {
        "local_time": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "result": { "type": "string" }
      }
    }
  }
}
