{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vj-interface-layer:contracts:project-manifest",
  "title": "ResolumeAdapter VJ Project Replay Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["replay_type", "schema_version", "session_id", "records"],
  "properties": {
    "replay_type": { "const": "ResolumeAdapterVJProjectReplay" },
    "schema_version": { "const": "0.1" },
    "session_id": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "event_id", "sequence", "input"],
        "properties": {
          "stage": { "enum": ["instar", "nayade", "imago"] },
          "event_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "input": { "type": "string", "minLength": 1 },
          "processor_observation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
