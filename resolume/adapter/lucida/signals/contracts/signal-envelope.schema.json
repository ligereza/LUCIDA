{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lucida:signals:signal-envelope",
  "title": "Signal Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "envelope_id",
    "event_id",
    "timestamp",
    "sequence",
    "source",
    "address",
    "arguments",
    "transport"
  ],
  "properties": {
    "contract_type": { "const": "SignalEnvelope" },
    "schema_version": { "const": "0.1" },
    "envelope_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "address": { "type": "string", "pattern": "^/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "arguments": {
      "type": "array",
      "items": { "type": ["string", "number", "integer", "boolean", "null"] }
    },
    "transport": { "const": "xio" }
  }
}
