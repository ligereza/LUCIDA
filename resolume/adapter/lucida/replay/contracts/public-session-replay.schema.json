{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resolume_adapter:lucida:public-session-replay",
  "title": "LUCIDA Public Session Replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "schema_version",
    "session_id",
    "status",
    "event_count",
    "signal_count",
    "proposal_count",
    "result_count",
    "phase_order",
    "records",
    "audit_log",
    "safety"
  ],
  "properties": {
    "contract_type": { "const": "LucidaPublicSessionReplayReport" },
    "schema_version": { "const": "0.1" },
    "session_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "REVIEW"] },
    "event_count": { "type": "integer", "minimum": 0 },
    "signal_count": { "type": "integer", "minimum": 0 },
    "proposal_count": { "type": "integer", "minimum": 0 },
    "result_count": { "type": "integer", "minimum": 0 },
    "phase_order": {
      "type": "array",
      "items": {
        "enum": ["preflight", "preparation", "show", "incident", "recovery", "closure"]
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "signal", "proposals", "results", "state_after", "audit"],
        "properties": {
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "timestamp", "phase", "event_type", "source"],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" },
              "phase": { "type": "string", "minLength": 1 },
              "event_type": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          },
          "signal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["envelope_id", "event_id", "timestamp", "sequence", "source", "address", "transport"],
            "properties": {
              "envelope_id": { "type": "string", "minLength": 1 },
              "event_id": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" },
              "sequence": { "type": "integer", "minimum": 0 },
              "source": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "minLength": 1 },
              "transport": { "enum": ["osc", "xio"] }
            }
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["proposal_id", "event_id", "phase", "operation", "risk", "requires_explicit_approval", "reversible", "execution_mode"],
              "properties": {
                "proposal_id": { "type": "string", "minLength": 1 },
                "event_id": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "operation": { "type": "string", "minLength": 1 },
                "risk": { "type": "string", "minLength": 1 },
                "requires_explicit_approval": { "const": true },
                "reversible": { "const": true },
                "execution_mode": { "const": "proposal_only" }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result_id", "proposal_id", "recorded_at", "status"],
              "properties": {
                "result_id": { "type": "string", "minLength": 1 },
                "proposal_id": { "type": "string", "minLength": 1 },
                "recorded_at": { "type": "string", "format": "date-time" },
                "status": { "type": "string", "minLength": 1 }
              }
            }
          },
          "state_after": { "$ref": "urn:resolume_adapter:lucida:overlay-view" },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "audit_id": { "type": "string", "minLength": 1 },
              "event_id": { "type": "string", "minLength": 1 },
              "envelope_id": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" },
              "sequence": { "type": "integer", "minimum": 0 },
              "source": { "type": "string", "minLength": 1 },
              "event_source": { "type": "string", "minLength": 1 },
              "proposal_ids": { "type": "array", "items": { "type": "string" } },
              "result_ids": { "type": "array", "items": { "type": "string" } },
              "mode": { "type": "string", "minLength": 1 },
              "external_side_effects": { "const": false },
              "status": { "enum": ["accepted", "rejected", "unknown"] },
              "execution_asserted": { "const": false }
            }
          }
        }
      }
    },
    "audit_log": {
      "type": "array",
      "items": { "$ref": "#/properties/records/items/properties/audit" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay_only", "proposal_only", "external_side_effects", "raw_payloads_included", "signal_arguments_included", "metadata_included"],
      "properties": {
        "replay_only": { "const": true },
        "proposal_only": { "const": true },
        "external_side_effects": { "const": false },
        "raw_payloads_included": { "const": false },
        "signal_arguments_included": { "const": false },
        "metadata_included": { "const": false }
      }
    }
  }
}
