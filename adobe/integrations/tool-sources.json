{
  "version": 1,
  "name": "agent-toolkit-source-inventory",
  "description": "Fuentes locales disponibles para el flujo de composición, visualización y automatización.",
  "rootPolicy": "relative-to-toolkit-or-parent",
  "sources": [
    {
      "id": "thi-ng-umbrella",
      "label": "thi.ng umbrella",
      "location": "parent",
      "path": "umbrella",
      "required": false,
      "kind": "monorepo",
      "status": "integrated-runtime",
      "capabilities": ["svg", "geometry", "math", "color", "interpolation", "layout", "data-structures"],
      "entrypoints": ["packages", "examples", "tools"],
      "runtimeAdapters": ["src/tools/source-runtime.mjs"],
      "metadataFiles": ["package.json", "yarn.lock", "pnpm-lock.yaml"]
    },
    {
      "id": "d3",
      "label": "D3",
      "location": "parent",
      "path": "d3",
      "required": false,
      "kind": "library",
      "status": "integrated-runtime",
      "capabilities": ["scales", "shapes", "hierarchies", "interpolation", "data-to-svg", "layout"],
      "entrypoints": ["src", "package.json"],
      "runtimeAdapters": ["src/tools/d3.mjs"],
      "metadataFiles": ["package.json"]
    },
    {
      "id": "three-js",
      "label": "three.js",
      "location": "parent",
      "path": "three.js",
      "required": false,
      "kind": "library",
      "status": "integrated-runtime",
      "capabilities": ["3d-scene", "camera", "materials", "textures", "rendering", "svg-3d-bridge"],
      "entrypoints": ["src", "examples", "package.json"],
      "runtimeAdapters": ["src/tools/source-runtime.mjs"],
      "metadataFiles": ["package.json"]
    },
    {
      "id": "effect",
      "label": "Effect",
      "location": "parent",
      "path": "effect",
      "required": false,
      "kind": "runtime-library",
      "status": "integrated-runtime",
      "capabilities": ["typed-workflows", "retry", "resource-safety", "structured-concurrency", "error-modeling"],
      "entrypoints": ["packages", "deno.json"],
      "runtimeAdapters": ["src/tools/source-runtime.mjs"],
      "metadataFiles": ["deno.json", "package.json"]
    },
    {
      "id": "rxjs",
      "label": "RxJS",
      "location": "parent",
      "path": "rxjs",
      "required": false,
      "kind": "runtime-library",
      "status": "integrated-runtime",
      "capabilities": ["events", "streams", "reactive-orchestration", "cancellation", "backpressure"],
      "entrypoints": ["packages", "package.json"],
      "runtimeAdapters": ["src/tools/source-runtime.mjs"],
      "metadataFiles": ["package.json"]
    },
    {
      "id": "stdlib",
      "label": "stdlib",
      "location": "parent",
      "path": "stdlib",
      "required": false,
      "kind": "scientific-library",
      "status": "integrated-runtime",
      "capabilities": ["numeric", "statistics", "signal-processing", "linear-algebra", "randomness", "data-analysis"],
      "entrypoints": ["lib", "dist", "examples", "docs"],
      "runtimeAdapters": ["src/tools/source-runtime.mjs"],
      "metadataFiles": ["package.json", "README.md"]
    },
    {
      "id": "gdkb",
      "label": "GDKB 0.6.1",
      "location": "toolkit",
      "path": "integrations/gdkb/v0.6.1",
      "required": true,
      "kind": "asset-and-knowledge-library",
      "status": "integrated-runtime",
      "capabilities": ["icons", "illustration-assets", "semantic-assets", "visual-references"],
      "entrypoints": ["README.md", "BUNDLE_MANIFEST.json"],
      "runtimeAdapters": ["adapters/gdkb/bridge.py"],
      "metadataFiles": ["manifest.json", "package.json", "README.md"]
    },
    {
      "id": "blender-adapter",
      "label": "Blender / Cycles / Geometry Nodes adapter",
      "location": "toolkit",
      "path": "adapters/blender",
      "required": true,
      "kind": "host-adapter",
      "status": "integrated-runtime",
      "capabilities": ["svg-import", "raster-import", "slide-layout", "geometry-nodes", "cycles-render", "manifest-driven-scene"],
      "entrypoints": ["agent_blender.py", "svg_assets.py"],
      "runtimeAdapters": ["src/adapters/blender.mjs", "adapters/blender/agent_blender.py"],
      "metadataFiles": []
    },
    {
      "id": "adobe-adapter",
      "label": "Adobe Photoshop / Illustrator / After Effects adapter",
      "location": "toolkit",
      "path": "adapters/adobe",
      "required": true,
      "kind": "host-adapter",
      "status": "partial-runtime",
      "capabilities": ["photoshop-separate-objects", "photoshop-svg-import", "illustrator-svg-import", "after-effects-queue", "premiere-queue"],
      "entrypoints": ["photoshop/agent.jsx", "photoshop/agent.psjs", "illustrator/agent.jsx", "README.md", "SCRIPTING-MAP.md"],
      "runtimeAdapters": ["src/adapters/adobe.mjs", "adapters/adobe/photoshop/agent.jsx", "adapters/adobe/illustrator/agent.jsx"],
      "metadataFiles": []
    }
  ]
}
