{
  "version": 1,
  "name": "agent-toolkit-scripting-map",
  "principles": [
    "Los manifiestos son la interfaz entre aplicaciones; no se transfieren escenas opacas.",
    "Cada etapa debe poder repetirse desde sus entradas declaradas.",
    "Blender es el compositor y renderizador final; Cycles es obligatorio para renders de producción.",
    "Adobe se usa como estación de separación, limpieza o preparación cuando la semántica de la imagen lo requiere."
  ],
  "contracts": {
    "asset": {
      "required": ["id", "kind", "source"],
      "optional": ["name", "part", "slide", "placement", "anchor", "scale", "rotation", "opacity", "material", "singleSlide"],
      "kinds": ["svg", "png", "jpg", "webp", "tiff", "exr", "mesh", "icon"]
    },
    "storyboard": {
      "required": ["canvas", "slides"],
      "canvas": ["width", "height", "resolution", "unit"],
      "slide": ["index", "title", "parts", "assets"]
    },
    "separation-manifest": {
      "required": ["source", "mode", "assets"],
      "assetFields": ["id", "source", "kind", "bounds", "selectionMethod", "selectionError", "singleSlide"]
    }
  },
  "surfaces": [
    {
      "id": "document-segmentation",
      "host": "toolkit",
      "script": "src/tools/document.mjs",
      "operations": ["document.extract", "document.segment", "document.storyboard"],
      "input": "document or extracted text",
      "output": "storyboard manifest"
    },
    {
      "id": "pdf-services",
      "host": "Adobe PDF Services",
      "script": "src/adapters/pdf-services.mjs",
      "operations": ["pdf.extract-structured", "pdf.extract-figures", "pdf.extract-bounds"],
      "input": "PDF plus server-side Adobe credentials",
      "output": "structuredData.json, layout manifest and extracted figure/table assets",
      "runtime": "@adobe/pdfservices-node-sdk; local extractor remains available as fallback"
    },
    {
      "id": "svg-asset-pipeline",
      "host": "toolkit",
      "script": "adapters/image/rasterize_svg.py",
      "operations": ["image.rasterize-svg", "image.validate-svg"],
      "input": "SVG with CSS, groups and transforms",
      "output": "sRGB raster or validated SVG"
    },
    {
      "id": "thi-ng-geometry",
      "host": "toolkit",
      "script": "src/tools/source-runtime.mjs",
      "operations": ["svg.thi-ng-geom"],
      "input": "declarative circles and rectangles",
      "output": "editable SVG generated by local thi.ng geometry",
      "runtime": "thi.ng umbrella packages/geom compiled from local TypeScript source"
    },
    {
      "id": "d3-data-layout",
      "host": "toolkit",
      "script": "src/tools/d3.mjs",
      "operations": ["data.d3-chart"],
      "input": "JSON or CSV rows",
      "output": "SVG generated with local D3 scales and domains",
      "runtime": "local D3 source at C:/IA/svg/d3"
    },
    {
      "id": "three-preview",
      "host": "toolkit",
      "script": "src/tools/source-runtime.mjs",
      "operations": ["scene3d.create"],
      "input": "declarative 3D object manifest",
      "output": "HTML preview plus local three.module.js",
      "runtime": "three.js build/three.module.js"
    },
    {
      "id": "stdlib-statistics",
      "host": "toolkit",
      "script": "src/tools/source-runtime.mjs",
      "operations": ["math.stdlib-stats"],
      "input": "numeric values",
      "output": "mean, variance and standard deviation",
      "runtime": "stdlib CommonJS statistical modules"
    },
    {
      "id": "rxjs-events",
      "host": "toolkit",
      "script": "src/tools/source-runtime.mjs",
      "operations": ["workflow.rxjs-events"],
      "input": "declarative event array",
      "output": "received timeline and type aggregation",
      "runtime": "RxJS Subject compiled from local TypeScript source"
    },
    {
      "id": "effect-retry",
      "host": "toolkit",
      "script": "src/tools/source-runtime.mjs",
      "operations": ["workflow.effect-retry"],
      "input": "bounded retry policy",
      "output": "attempts, status and result",
      "runtime": "Effect and Schedule compiled from local TypeScript source"
    },
    {
      "id": "photoshop",
      "host": "Adobe Photoshop",
      "scripts": ["adapters/adobe/photoshop/agent.psjs", "adapters/adobe/photoshop/agent.jsx"],
      "operations": ["photoshop.import-svg", "photoshop.separate-objects", "photoshop.export"],
      "input": "staged job files and regions manifest",
      "output": "PSD, transparent PNG assets and separation manifest",
      "runtime": "UXP queue or COM/ExtendScript fallback"
    },
    {
      "id": "illustrator",
      "host": "Adobe Illustrator",
      "scripts": ["adapters/adobe/illustrator/agent.jsx"],
      "operations": ["illustrator.import-svg", "illustrator.export-svg", "illustrator.export-png"],
      "input": "SVG, asset manifest and target canvas",
      "output": "clean SVG or raster export",
      "runtime": "ExtendScript queue adapter when host is available"
    },
    {
      "id": "geometry-nodes",
      "host": "Blender",
      "script": "adapters/blender/agent_blender.py",
      "operations": ["blender.import-svg", "blender.import-raster", "blender.layout-scene", "blender.render-cycles"],
      "nodeGroups": ["GN_Asset_2D_Transform"],
      "input": "storyboard and asset manifests",
      "output": "editable Blender scene and Cycles renders",
      "runtime": "Blender Python, preferably through the checked-in console bridge"
    },
    {
      "id": "motion-composition",
      "host": "Blender",
      "script": "adapters/blender/agent_blender.py",
      "operations": ["blender.keyframe-asset", "blender.pulse-asset", "blender.render-sheet"],
      "input": "asset transform controls and slide timeline",
      "output": "animated scene or review sheet"
    },
    {
      "id": "multi-app-composition",
      "host": "toolkit",
      "script": "src/multi-app-workflow.mjs",
      "operations": ["workflow.multi-app-composition"],
      "input": "storyboard plus optional Adobe input",
      "output": "single job with staged manifest, Blender scene/render and Adobe commands",
      "runtime": "Blender adapter + Adobe queue contract"
    }
  ],
  "sourceRoles": {
    "thi-ng-umbrella": ["svg primitives", "geometry utilities", "color and interpolation", "data structures"],
    "d3": ["semantic-to-layout mapping", "scales", "hierarchies", "data-driven SVG"],
    "three-js": ["web preview", "3D reference", "camera and material prototypes"],
    "effect": ["durable job orchestration", "retry and resource safety"],
    "rxjs": ["event streams", "live controls", "render progress"],
    "stdlib": ["numerical analysis", "signal and statistical helpers"],
    "gdkb": ["semantic icon and illustration lookup", "asset references"],
    "blender-adapter": ["canonical composition and Cycles output"],
    "adobe-adapter": ["object separation and vector cleanup"]
  }
}
