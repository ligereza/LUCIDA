// Small strict JSON parser/stringifier for legacy Adobe ExtendScript hosts.
var AgentJson = (function () {
  function parse(text) {
    var source = String(text);
    var index = 0;

    function fail(message) { throw new Error("Invalid JSON at " + index + ": " + message); }
    function skip() {
      while (index < source.length && /\s/.test(source.charAt(index))) index += 1;
    }
    function stringValue() {
      if (source.charAt(index) !== '"') fail("expected string");
      index += 1;
      var result = "";
      while (index < source.length) {
        var character = source.charAt(index++);
        if (character === '"') return result;
        if (character === "\\") {
          var escaped = source.charAt(index++);
          if (escaped === '"' || escaped === "\\" || escaped === '/') result += escaped;
          else if (escaped === 'b') result += "\b";
          else if (escaped === 'f') result += "\f";
          else if (escaped === 'n') result += "\n";
          else if (escaped === 'r') result += "\r";
          else if (escaped === 't') result += "\t";
          else if (escaped === 'u') {
            var hex = source.substr(index, 4);
            if (!/^[0-9a-fA-F]{4}$/.test(hex)) fail("invalid unicode escape");
            result += String.fromCharCode(parseInt(hex, 16));
            index += 4;
          } else fail("invalid escape");
        } else {
          if (character < " ") fail("control character in string");
          result += character;
        }
      }
      fail("unterminated string");
    }
    function numberValue() {
      var start = index;
      if (source.charAt(index) === '-') index += 1;
      if (source.charAt(index) === '0') index += 1;
      else {
        if (!/[1-9]/.test(source.charAt(index))) fail("invalid number");
        while (/[0-9]/.test(source.charAt(index))) index += 1;
      }
      if (source.charAt(index) === '.') {
        index += 1;
        if (!/[0-9]/.test(source.charAt(index))) fail("invalid fraction");
        while (/[0-9]/.test(source.charAt(index))) index += 1;
      }
      if (source.charAt(index) === 'e' || source.charAt(index) === 'E') {
        index += 1;
        if (source.charAt(index) === '+' || source.charAt(index) === '-') index += 1;
        if (!/[0-9]/.test(source.charAt(index))) fail("invalid exponent");
        while (/[0-9]/.test(source.charAt(index))) index += 1;
      }
      var result = Number(source.substring(start, index));
      if (!isFinite(result)) fail("invalid number");
      return result;
    }
    function value() {
      skip();
      var character = source.charAt(index);
      if (character === '"') return stringValue();
      if (character === '{') return objectValue();
      if (character === '[') return arrayValue();
      if (source.substr(index, 4) === "true") { index += 4; return true; }
      if (source.substr(index, 5) === "false") { index += 5; return false; }
      if (source.substr(index, 4) === "null") { index += 4; return null; }
      if (character === '-' || /[0-9]/.test(character)) return numberValue();
      fail("unexpected token");
    }
    function arrayValue() {
      var result = [];
      index += 1;
      skip();
      if (source.charAt(index) === ']') { index += 1; return result; }
      while (true) {
        result.push(value());
        skip();
        if (source.charAt(index) === ']') { index += 1; return result; }
        if (source.charAt(index++) !== ',') fail("expected comma");
      }
    }
    function objectValue() {
      var result = {};
      index += 1;
      skip();
      if (source.charAt(index) === '}') { index += 1; return result; }
      while (true) {
        skip();
        var key = stringValue();
        skip();
        if (source.charAt(index++) !== ':') fail("expected colon");
        result[key] = value();
        skip();
        if (source.charAt(index) === '}') { index += 1; return result; }
        if (source.charAt(index++) !== ',') fail("expected comma");
      }
    }

    var result = value();
    skip();
    if (index !== source.length) fail("trailing content");
    return result;
  }

  function quote(value) {
    var result = '"';
    for (var i = 0; i < value.length; i += 1) {
      var character = value.charAt(i);
      if (character === '"') result += '\\"';
      else if (character === "\\") result += "\\\\";
      else if (character === "\b") result += "\\b";
      else if (character === "\f") result += "\\f";
      else if (character === "\n") result += "\\n";
      else if (character === "\r") result += "\\r";
      else if (character === "\t") result += "\\t";
      else result += character;
    }
    return result + '"';
  }
  function stringify(value) {
    if (value === null) return "null";
    var type = typeof value;
    if (type === "string") return quote(value);
    if (type === "number") return isFinite(value) ? String(value) : "null";
    if (type === "boolean") return value ? "true" : "false";
    if (value instanceof Array) {
      var items = [];
      for (var i = 0; i < value.length; i += 1) items.push(stringify(value[i]));
      return "[" + items.join(",") + "]";
    }
    if (type === "object") {
      var pairs = [];
      for (var key in value) if (value.hasOwnProperty(key)) pairs.push(quote(key) + ":" + stringify(value[key]));
      return "{" + pairs.join(",") + "}";
    }
    return "null";
  }
  return { parse: parse, stringify: stringify };
}());
